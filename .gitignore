# ---------------------------------------------------------------------------
# LuOS .gitignore - keep the repository source-only: text, scripts and code.
# Every build product (objects, images, firmware, binaries) is regenerated by
# make and removed by make clean. Nothing binary belongs in git.
# ---------------------------------------------------------------------------

# kernel build
build/
kernel.bin
*.o
*.a
*.bin
*.iso
isodir_limine/

# built-in filesystem and GPU firmware (downloaded/staged from Ubuntu packages)
userspace/sysroot/build/
userspace/drm/gen/
userspace/drm/bin/
userspace/tests/bin/
userspace/tests/lib/
userspace/vulkan/
LuOS_gpu_firmware.zip
userspace/sysroot/firmware/

# tool tarballs
*.tar.gz
*.tar.xz
*.zip

# khronos headers for the table generator (fetched on demand)
scripts/khronos-headers/

# disk and VM images
*.img
*.qcow2
*.vdi
*.vhd
*.vmdk
*.raw
*.vdisk

# logs, dumps, recordings
*.log
serial*.txt
dmesg*.txt
log*.txt
*.wav
*.ppm
*.png

# firmware images flashed onto test hardware
OVMF_VARS*.fd
nvram

# editors and tooling
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]
.venv/
compile_commands.json
.clangd/
tags
TAGS
GTAGS
GPATH
GRTAGS
