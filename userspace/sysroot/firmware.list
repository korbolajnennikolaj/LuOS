# Firmware blobs put into the built-in filesystem at /usr/lib/firmware (/lib/firmware) by mkinitfs.py.
# Taken unmodified from Ubuntu 24.04's linux-firmware-<group>-graphics packages; names are the ones the
# Linux 6.18 drivers request (MODULE_FIRMWARE). Columns: group, path below /lib/firmware.
# Groups are selected with INITFS_FIRMWARE (make) / --firmware (mkinitfs.py).

# AMD Radeon 780M / 760M (Phoenix: GC 11.0.1, PSP 13.0.4, SDMA 6.0.1, DCN 3.1.4, VCN 4.0.2)
amd amdgpu/gc_11_0_1_pfp.bin
amd amdgpu/gc_11_0_1_me.bin
amd amdgpu/gc_11_0_1_mec.bin
amd amdgpu/gc_11_0_1_rlc.bin
amd amdgpu/gc_11_0_1_imu.bin
amd amdgpu/gc_11_0_1_mes.bin
amd amdgpu/gc_11_0_1_mes1.bin
amd amdgpu/gc_11_0_1_mes_2.bin
amd amdgpu/psp_13_0_4_toc.bin
amd amdgpu/psp_13_0_4_ta.bin
amd amdgpu/sdma_6_0_1.bin
amd amdgpu/dcn_3_1_4_dmcub.bin
amd amdgpu/vcn_4_0_2.bin

# AMD Vega 8 in Ryzen 5000G (Cezanne, "green sardine")
amd amdgpu/green_sardine_asd.bin
amd amdgpu/green_sardine_ta.bin
amd amdgpu/green_sardine_pfp.bin
amd amdgpu/green_sardine_me.bin
amd amdgpu/green_sardine_ce.bin
amd amdgpu/green_sardine_mec.bin
amd amdgpu/green_sardine_mec2.bin
amd amdgpu/green_sardine_rlc.bin
amd amdgpu/green_sardine_sdma.bin
amd amdgpu/green_sardine_dmcub.bin
amd amdgpu/green_sardine_vcn.bin

# AMD Vega 8/11 in Ryzen 2000G (Raven Ridge)
amd amdgpu/raven_gpu_info.bin
amd amdgpu/raven_asd.bin
amd amdgpu/raven_ta.bin
amd amdgpu/raven_pfp.bin
amd amdgpu/raven_me.bin
amd amdgpu/raven_ce.bin
amd amdgpu/raven_mec.bin
amd amdgpu/raven_mec2.bin
amd amdgpu/raven_rlc.bin
amd amdgpu/raven_kicker_rlc.bin
amd amdgpu/raven_sdma.bin
amd amdgpu/raven_dmcu.bin
amd amdgpu/raven_vcn.bin

# Intel HD Graphics 500/505 (Apollo Lake, i915 "bxt"); GuC/HuC are only used with i915.enable_guc
intel i915/bxt_dmc_ver1_07.bin
# Old Intel generations: gen6-8 (Sandy Bridge .. Broadwell) DMC blobs i915 requests;
# gen2-5 (i830..Ironlake) need no firmware at all - the GTT is programmed directly
intel i915/snb_dmc_ver1_04.bin
intel i915/ivb_dmc_ver1_07.bin
intel i915/hsw_dmc_ver1_04.bin
intel i915/bdw_dmc_ver1_23.bin
intel i915/bxt_guc_70.1.1.bin
intel i915/bxt_huc_2.0.0.bin

# NVIDIA GTX 1650 (TU117) and RTX 3060 (GA106): nouveau's GSP-RM 535 (570 is tried first, 535 is the fallback)
nvidia nvidia/tu117/gsp/gsp-535.113.01.bin
nvidia nvidia/tu117/gsp/bootloader-535.113.01.bin
nvidia nvidia/tu117/gsp/booter_load-535.113.01.bin
nvidia nvidia/tu117/gsp/booter_unload-535.113.01.bin
nvidia nvidia/ga106/gsp/gsp-535.113.01.bin
nvidia nvidia/ga106/gsp/bootloader-535.113.01.bin
nvidia nvidia/ga106/gsp/booter_load-535.113.01.bin
nvidia nvidia/ga106/gsp/booter_unload-535.113.01.bin
