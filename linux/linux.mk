# Linux drivers built against the LinuxKPI. Included by the top-level Makefile.

LINUX_DIR = linux
LINUX_BUILD = $(BUILD_DIR)/linux

# The object list reproduces the link order of Linux's drivers/gpu/drm/Makefile: the DRM core and its
# helpers (drm_*.c, display/, scheduler/, ttm/, ...) are linked before the vendor drivers. drm_core_init()
# is a module_init in Linux 6.18 — the same initcall level as amdgpu_init() / i915_init() /
# nouveau_drm_init() — so within the level the section order (the link order) decides who runs first,
# and a vendor driver's probe would die with "DRM core is not initialized" (a plain alphabetical sort
# puts amd/ in front of drm_drv.c).
LINUX_DRM_VENDOR_DIRS = ^drivers/gpu/drm/(amd|i810|i915|nouveau)/
LINUX_UPSTREAM_CORE = $(shell sed -e 's/\#.*//' $(LINUX_DIR)/upstream.list | grep '\.c$$' | sort -u | grep -vE '$(LINUX_DRM_VENDOR_DIRS)')
LINUX_UPSTREAM_DRIVERS = $(shell sed -e 's/\#.*//' $(LINUX_DIR)/upstream.list | grep '\.c$$' | sort -u | grep -E '$(LINUX_DRM_VENDOR_DIRS)')
LINUX_UPSTREAM_SOURCES = $(filter-out %_clear_kernel.c, \
	$(addprefix $(LINUX_DIR)/upstream/, $(LINUX_UPSTREAM_CORE) $(LINUX_UPSTREAM_DRIVERS)))
LINUX_KPI_SOURCES = $(wildcard $(LINUX_DIR)/kpi/src/*.c)
LINUX_OBJECTS = $(patsubst $(LINUX_DIR)/%.c, $(LINUX_BUILD)/%.o, $(LINUX_UPSTREAM_SOURCES) $(LINUX_KPI_SOURCES))
LINUX_OBJ = $(LINUX_BUILD)/linux.o

# entry points LuOS calls; every other symbol of the Linux side is made local so names never clash
LINUX_EXPORTS = lkpi_init lkpi_status lkpi_gpu_reinit lkpi_gpu_restart lkpi_chrdev_open lkpi_file_read lkpi_file_write lkpi_file_ioctl lkpi_file_poll \
	lkpi_file_llseek lkpi_file_mmap lkpi_file_put lkpi_file_get lkpi_file_info \
	lkpi_sysfs_lookup lkpi_sysfs_read lkpi_sysfs_readlink lkpi_sysfs_readdir lkpi_set_drm_debug \
	lkpi_zstd_workspace_size lkpi_zstd_decompress \
	lkpi_gpu_enumerate lkpi_gpu_driver_list lkpi_gpu_bind_one lkpi_gpu_unbind_one \
	lkpi_gpu_open_dev lkpi_gpu_close_dev lkpi_gpu_ioctl lkpi_gpu_drm_version lkpi_console_hold_connector lkpi_console_restore \
	lkpi_gpu_gem_vmap lkpi_gpu_gem_vunmap lkpi_gpu_gem_share lkpi_gpu_take_master \
	lkpi_backlight_count lkpi_backlight_get lkpi_backlight_set

LINUX_CFLAGS = -std=gnu11 -O2 -m64 -funsigned-char -fno-strict-aliasing -fno-common -fno-delete-null-pointer-checks \
	-ffreestanding -fno-PIE -fno-pic -mcmodel=kernel -mno-red-zone -mno-sse -mno-sse2 -mno-mmx -mno-3dnow -mno-avx \
	-mno-80387 -fno-stack-protector -fno-tree-loop-distribute-patterns -nostdinc -D__KERNEL__ \
	-include $(LINUX_DIR)/kpi/include/lkpi/prelude.h \
	-I$(LINUX_DIR)/kpi/include -I$(LINUX_DIR)/upstream/include -I$(LINUX_DIR)/kpi/include/uapi \
	-I$(LINUX_DIR)/upstream/include/uapi -I$(LINUX_DIR)/upstream/arch/x86/include/uapi \
	-Wall -Wno-unused-parameter -Wno-sign-compare -Wno-missing-field-initializers -Wno-pointer-sign \
	-Wno-unused-function -Wno-address-of-packed-member -Wno-format-truncation -Wno-format -Wno-unused-variable \
	-Wno-unused-value -Wno-unused-but-set-variable -Wno-unused-result -Wno-maybe-uninitialized \
	-Werror=implicit-function-declaration -Werror=incompatible-pointer-types -Werror=int-conversion \
	-Werror=return-type -Werror=implicit-int

# module names and per-driver flags as the drivers' own Makefiles set them; parameters are "<module>.<name>"
$(LINUX_BUILD)/upstream/drivers/gpu/drm/%.o: LINUX_MODNAME = drm
$(LINUX_BUILD)/upstream/drivers/gpu/drm/virtio/%.o: LINUX_MODNAME = virtio_gpu
$(LINUX_BUILD)/upstream/drivers/gpu/drm/tiny/%.o: LINUX_MODNAME = bochs
$(LINUX_BUILD)/upstream/drivers/gpu/drm/sysfb/%.o: LINUX_MODNAME = simpledrm
$(LINUX_BUILD)/upstream/drivers/gpu/drm/i915/%.o: LINUX_MODNAME = i915
$(LINUX_BUILD)/upstream/drivers/gpu/drm/i915/%.o: LINUX_EXTRA_CFLAGS = -DI915 -I$(LINUX_DIR)/upstream/drivers/gpu/drm/i915
$(LINUX_BUILD)/upstream/drivers/char/agp/%.o: LINUX_MODNAME = agp_intel
$(LINUX_BUILD)/upstream/drivers/char/agp/%.o: LINUX_EXTRA_CFLAGS = -I$(LINUX_DIR)/upstream/drivers/char/agp -DCONFIG_AGP_INTEL=1
$(LINUX_BUILD)/upstream/drivers/gpu/drm/i810/%.o: LINUX_MODNAME = i810
$(LINUX_BUILD)/upstream/drivers/gpu/drm/i810/%.o: LINUX_EXTRA_CFLAGS = -I$(LINUX_DIR)/upstream/drivers/char/agp
$(LINUX_BUILD)/upstream/drivers/gpu/drm/ttm/%.o: LINUX_MODNAME = ttm
$(LINUX_BUILD)/upstream/drivers/gpu/drm/display/%.o: LINUX_MODNAME = drm_display_helper

# amdgpu and nouveau: flags from the drivers' Kbuild files, generated by tools/lkgen.py (LINUX_FILE_CFLAGS[_REMOVE]
# are the per-file CFLAGS_x.o / CFLAGS_REMOVE_x.o, which the display core's floating point code needs)
include $(wildcard $(LINUX_DIR)/gen/*.mk)

$(LINUX_BUILD)/%.o: $(LINUX_DIR)/%.c
	@mkdir -p $(dir $@)
	@echo "[CC]  Linux $<"
	@$(CC) $(filter-out $(LINUX_FILE_CFLAGS_REMOVE),$(LINUX_CFLAGS)) $(DEPFLAGS) -I$(dir $<) $(LINUX_EXTRA_CFLAGS) $(LINUX_FILE_CFLAGS) \
		-DKBUILD_MODNAME='"$(or $(LINUX_MODNAME),$(basename $(notdir $<)))"' \
		-DKBUILD_BASENAME='"$(basename $(notdir $<))"' -c $< -o $@

$(LINUX_OBJ): $(LINUX_OBJECTS)
	@echo "[LD]  Linux driver environment"
	@$(LD) -r -m elf_x86_64 -o $@.tmp $(LINUX_OBJECTS)
	@$(OBJCOPY) $(addprefix --keep-global-symbol=, $(LINUX_EXPORTS)) $@.tmp $@
	@rm -f $@.tmp

-include $(LINUX_OBJECTS:.o=.d)
